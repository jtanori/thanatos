# Copy to .env (local) — never commit real secrets.
# Staging/production: set these in your hosting provider's env dashboard, NOT in a file.

# --- Required: database (all environments) ---
# Local Compose maps POSTGRES_PORT (default 5432) to the container's 5432.
# POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Required in staging/production: public app URL (used for Stripe redirects) ---
# NEXT_PUBLIC_URL=https://staging.tu-dominio.com
# NEXT_PUBLIC_URL=https://tu-dominio.com

# --- Stripe (optional locally — without these, checkout runs in demo mode) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Optional fixed Price IDs (if empty, the app creates prices dynamically):
# STRIPE_PRICE_CELESTIAL_MXN=price_...
# STRIPE_PRICE_CELESTIAL_USD=price_...
# STRIPE_PRICE_CELESTIAL_ANNUAL_MXN=price_...
# STRIPE_PRICE_CELESTIAL_ANNUAL_USD=price_...

# --- Local-only seed CLI (scripts/local/seed.ts) ---
# Never set these in staging or production.
# ALLOW_LOCAL_SEED=1
# LOCAL_SEED_PASSWORD=choose-a-local-password

# --- Local-only Stripe fallbacks ---
# Never enable these in staging or production.
# ALLOW_UNSIGNED_STRIPE_WEBHOOKS=1
# ALLOW_DEMO_BILLING=1
